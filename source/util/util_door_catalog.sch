FUNC MODEL_NAMES DOOR_MODEL_FOR_CHOICE(INT choice)
    IF choice < 0 OR choice >= DOOR_MODEL_COUNT() RETURN PROP_DOOR_01 ENDIF
    IF choice < 96 RETURN DOOR_MODEL_PAGE_0(choice - 0) ENDIF
    IF choice < 192 RETURN DOOR_MODEL_PAGE_1(choice - 96) ENDIF
    IF choice < 288 RETURN DOOR_MODEL_PAGE_2(choice - 192) ENDIF
    IF choice < 384 RETURN DOOR_MODEL_PAGE_3(choice - 288) ENDIF
    IF choice < 480 RETURN DOOR_MODEL_PAGE_4(choice - 384) ENDIF
    IF choice < 576 RETURN DOOR_MODEL_PAGE_5(choice - 480) ENDIF
    IF choice < 672 RETURN DOOR_MODEL_PAGE_6(choice - 576) ENDIF
    IF choice < 768 RETURN DOOR_MODEL_PAGE_7(choice - 672) ENDIF
    RETURN PROP_DOOR_01
ENDFUNC
