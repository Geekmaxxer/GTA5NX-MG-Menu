    IF charId < 56 RETURN STORY_CHAR_DEFAULT_MODEL_NAME_PAGE_0(charId) ENDIF
    RETURN STORY_CHAR_DEFAULT_MODEL_NAME_PAGE_1(charId - 56)
ENDFUNC

