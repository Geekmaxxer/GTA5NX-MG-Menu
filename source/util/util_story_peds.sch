FUNC STRING STORY_CHAR_DISPLAY_NAME(INT charId)
    IF charId < 56 RETURN STORY_CHAR_DISPLAY_NAME_PAGE_0(charId) ENDIF
    RETURN STORY_CHAR_DISPLAY_NAME_PAGE_1(charId - 56)
ENDFUNC

