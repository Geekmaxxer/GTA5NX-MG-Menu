FUNC MODEL_NAMES PED_MODEL_FOR_CHOICE(INT choice)
    IF choice < 0 OR choice >= PED_CHOICE_COUNT() RETURN PLAYER_ZERO ENDIF
    IF choice < 96 RETURN PED_MODEL_PAGE_0(choice - 0) ENDIF
    IF choice < 192 RETURN PED_MODEL_PAGE_1(choice - 96) ENDIF
    IF choice < 288 RETURN PED_MODEL_PAGE_2(choice - 192) ENDIF
    IF choice < 384 RETURN PED_MODEL_PAGE_3(choice - 288) ENDIF
    IF choice < 480 RETURN PED_MODEL_PAGE_4(choice - 384) ENDIF
    IF choice < 576 RETURN PED_MODEL_PAGE_5(choice - 480) ENDIF
    IF choice < 672 RETURN PED_MODEL_PAGE_6(choice - 576) ENDIF
    IF choice < 768 RETURN PED_MODEL_PAGE_7(choice - 672) ENDIF
    RETURN PLAYER_ZERO
ENDFUNC

FUNC STRING PED_NAME_FOR_CHOICE(INT choice)
    IF choice < 0 OR choice >= PED_CHOICE_COUNT() RETURN "UNKNOWN_PED" ENDIF
    IF choice < 96 RETURN PED_NAME_PAGE_0(choice - 0) ENDIF
    IF choice < 192 RETURN PED_NAME_PAGE_1(choice - 96) ENDIF
    IF choice < 288 RETURN PED_NAME_PAGE_2(choice - 192) ENDIF
    IF choice < 384 RETURN PED_NAME_PAGE_3(choice - 288) ENDIF
    IF choice < 480 RETURN PED_NAME_PAGE_4(choice - 384) ENDIF
    IF choice < 576 RETURN PED_NAME_PAGE_5(choice - 480) ENDIF
    IF choice < 672 RETURN PED_NAME_PAGE_6(choice - 576) ENDIF
    IF choice < 768 RETURN PED_NAME_PAGE_7(choice - 672) ENDIF
    RETURN "UNKNOWN_PED"
ENDFUNC

FUNC INT FIND_PED_CHOICE_BY_NAME(STRING modelName)
    INT wantedHash = GET_HASH_KEY(modelName)
    INT choice = 0
    WHILE choice < PED_CHOICE_COUNT()
        IF GET_HASH_KEY(PED_NAME_FOR_CHOICE(choice)) = wantedHash RETURN choice ENDIF
        choice = choice + 1
    ENDWHILE
    RETURN -1
ENDFUNC

FUNC MODEL_NAMES STRIPPER_MODEL_FOR_CHOICE(INT choice)
    IF choice = 1 RETURN S_F_Y_STRIPPER_02 ENDIF
    IF choice = 2 RETURN S_F_Y_STRIPPERLITE ENDIF
    IF choice = 3 RETURN MP_F_STRIPPERLITE ENDIF
    RETURN S_F_Y_STRIPPER_01
ENDFUNC

FUNC STRING STRIPPER_NAME_FOR_CHOICE(INT choice)
    IF choice = 1 RETURN "S_F_Y_STRIPPER_02" ENDIF
    IF choice = 2 RETURN "S_F_Y_STRIPPERLITE" ENDIF
    IF choice = 3 RETURN "MP_F_STRIPPERLITE" ENDIF
    RETURN "S_F_Y_STRIPPER_01"
ENDFUNC

FUNC INT SLOT_FOR_MODEL(MODEL_NAMES model)
    IF model = PLAYER_ONE RETURN 1 ENDIF
    IF model = PLAYER_TWO RETURN 2 ENDIF
    RETURN 0
ENDFUNC

PROC SAVE_ACTIVE_CHARACTER_PED()
    MODEL_NAMES currentModel = GET_ENTITY_MODEL(PLAYER_PED_ID())
    INT liveSlot = SLOT_FOR_MODEL(currentModel)
    IF liveSlot = 0 g_franklin_ped = currentModel ENDIF
    IF liveSlot = 1 g_michael_ped = currentModel ENDIF
    IF liveSlot = 2 g_trevor_ped = currentModel ENDIF
ENDPROC

FUNC MODEL_NAMES SAVED_CHARACTER_PED(INT slot)
    IF slot = 0 RETURN g_franklin_ped ENDIF
    IF slot = 1 RETURN g_michael_ped ENDIF
    RETURN g_trevor_ped
ENDFUNC

FUNC INT PED_CHOICE_FOR_MODEL(MODEL_NAMES model)
    INT choice = 0
    WHILE choice < PED_CHOICE_COUNT()
        IF PED_MODEL_FOR_CHOICE(choice) = model RETURN choice ENDIF
        choice = choice + 1
    ENDWHILE
    RETURN -1
ENDFUNC

FUNC STRING CURRENT_PED_SEARCH_LABEL()
    RETURN g_current_ped_label
ENDFUNC

PROC REFRESH_CURRENT_PED_LABEL()
    MODEL_NAMES currentModel = GET_ENTITY_MODEL(PLAYER_PED_ID())
    INT catalogChoice = 0
    IF currentModel = g_current_ped_label_model EXIT ENDIF
    catalogChoice = PED_CHOICE_FOR_MODEL(currentModel)
    IF catalogChoice >= 0
        g_current_ped_label_model = currentModel
        g_current_ped_label = PED_NAME_FOR_CHOICE(catalogChoice)
    ENDIF
ENDPROC

FUNC STRING CURRENT_VEHICLE_SEARCH_LABEL()
    IF IS_PED_IN_ANY_VEHICLE(PLAYER_PED_ID())
        RETURN GET_DISPLAY_NAME_FROM_VEHICLE_MODEL(GET_ENTITY_MODEL(GET_VEHICLE_PED_IS_IN(PLAYER_PED_ID())))
    ENDIF
    RETURN "TYPE MODEL"
ENDFUNC

PROC REQUEST_PED_CHANGE(MODEL_NAMES model)
    IF IS_PED_IN_ANY_VEHICLE(PLAYER_PED_ID()) EXIT ENDIF
    IF NOT IS_MODEL_IN_CDIMAGE(model) OR NOT IS_MODEL_VALID(model) EXIT ENDIF
    IF g_ped_change_pending
        IF g_pending_ped_model = model EXIT ENDIF
        SET_MODEL_AS_NO_LONGER_NEEDED(g_pending_ped_model)
        g_ped_change_pending = FALSE
    ENDIF
    REQUEST_MODEL(model)
    g_pending_ped_model = model
    g_ped_change_pending = TRUE
    g_ped_request_time = GET_GAME_TIMER()
ENDPROC

PROC FINISH_PED_CHANGE()
    IF HAS_MODEL_LOADED(g_pending_ped_model)
        SET_PLAYER_MODEL(PLAYER_ID(), g_pending_ped_model)
        SET_PED_DEFAULT_COMPONENT_VARIATION(PLAYER_PED_ID())
        SAVE_ACTIVE_CHARACTER_PED()
        IF g_ped_search_is_custom
            g_current_ped_label = g_ped_search_value
            g_current_ped_label_model = g_pending_ped_model
        ENDIF
    ENDIF
    SET_MODEL_AS_NO_LONGER_NEEDED(g_pending_ped_model)
    g_ped_change_pending = FALSE
ENDPROC

PROC MAINTAIN_PED_CHANGE_REQUEST()
    IF NOT g_ped_change_pending EXIT ENDIF
    IF HAS_MODEL_LOADED(g_pending_ped_model) EXIT ENDIF
    REQUEST_MODEL(g_pending_ped_model)
ENDPROC

FUNC MODEL_NAMES STORY_MODEL_FOR_SLOT(INT slot)
    IF slot = 1 RETURN PLAYER_ONE ENDIF
    IF slot = 2 RETURN PLAYER_TWO ENDIF
    RETURN PLAYER_ZERO
ENDFUNC

PROC PROCESS_PED_DEATH_RECOVERY()
    MODEL_NAMES currentModel = GET_ENTITY_MODEL(PLAYER_PED_ID())
    IF currentModel = PLAYER_ZERO g_character_slot = 0 ENDIF
    IF currentModel = PLAYER_ONE g_character_slot = 1 ENDIF
    IF currentModel = PLAYER_TWO g_character_slot = 2 ENDIF
    MODEL_NAMES storyModel = STORY_MODEL_FOR_SLOT(g_character_slot)
    BOOL tripped = FALSE
    IF IS_PED_INJURED(PLAYER_PED_ID()) tripped = TRUE ENDIF
    IF IS_ENTITY_DEAD(PLAYER_PED_ID()) tripped = TRUE ENDIF
    IF tripped
        IF currentModel != storyModel AND NOT g_ped_change_pending
            IF NOT g_ped_death_recovery
                g_ped_pre_death_model = currentModel
                g_ped_death_recovery = TRUE
            ENDIF
            IF IS_MODEL_IN_CDIMAGE(storyModel) AND IS_MODEL_VALID(storyModel)
                SET_PLAYER_MODEL(PLAYER_ID(), storyModel)
                SET_PED_DEFAULT_COMPONENT_VARIATION(PLAYER_PED_ID())
            ENDIF
        ENDIF
        g_ped_stable_control_ticks = 0
    ELIF g_ped_death_recovery
        IF NOT g_ped_change_pending AND IS_PLAYER_CONTROL_ON(PLAYER_ID()) AND NOT IS_PED_IN_ANY_VEHICLE(PLAYER_PED_ID())
            g_ped_stable_control_ticks = g_ped_stable_control_ticks + 1
            IF g_ped_stable_control_ticks >= 90
                g_ped_death_recovery = FALSE
                g_ped_stable_control_ticks = 0
                SAVE_ACTIVE_CHARACTER_PED()
                REQUEST_PED_CHANGE(g_ped_pre_death_model)
            ENDIF
        ELSE
            g_ped_stable_control_ticks = 0
        ENDIF
    ENDIF
ENDPROC

PROC APPLY_CHARACTER_PROFILE(INT slot)
    g_character_slot = slot
    REQUEST_PED_CHANGE(SAVED_CHARACTER_PED(slot))
ENDPROC

PROC ADJUST_PED_SELECTOR(INT direction)
    INT nextSlot = 0
    IF g_item = 2
        nextSlot = g_character_slot + direction
        IF nextSlot < 0 nextSlot = 2 ENDIF
        IF nextSlot > 2 nextSlot = 0 ENDIF
        SAVE_ACTIVE_CHARACTER_PED()
        APPLY_CHARACTER_PROFILE(nextSlot)
    ENDIF
ENDPROC

PROC DRAW_CHARACTER_PROFILE(FLOAT y, BOOL selected)
    IF g_character_slot = 0 DRAW_OPTION(y, "Character Profile:", "< Michael >", selected, 3) ENDIF
    IF g_character_slot = 1 DRAW_OPTION(y, "Character Profile:", "< Franklin >", selected, 3) ENDIF
    IF g_character_slot = 2 DRAW_OPTION(y, "Character Profile:", "< Trevor >", selected, 3) ENDIF
ENDPROC

PROC DRAW_PED_PAGE()
    MENU_TEXT(g_menu_x - 0.130, 0.198, 0.270, 255, 255, 255, "PED CHANGER")
    DRAW_MENU_VERSION_TAG()
    INT index = g_scroll
    INT row = 0
    WHILE row < 8 AND index < PED_CHOICE_COUNT() + 3
        FLOAT y = 0.268 + (TO_FLOAT(row) * ROW_H)
        IF index = 0
            IF g_ped_search_not_found
                DRAW_OPTION(y, "PED Search", "NOT FOUND", g_item = index, 0)
            ELIF g_ped_search_has_value
                DRAW_OPTION(y, "PED Search", g_ped_search_value, g_item = index, 1)
            ELSE
                DRAW_OPTION(y, "PED Search", CURRENT_PED_SEARCH_LABEL(), g_item = index, 2)
            ENDIF
        ELIF index = 1
            DRAW_OPTION(y, "Random PED", "APPLY", g_item = index, 2)
        ELIF index = 2
            DRAW_CHARACTER_PROFILE(y, g_item = index)
        ELSE
            DRAW_OPTION(y, "PED:", PED_NAME_FOR_CHOICE(index - 3), g_item = index, 2)
        ENDIF
        index = index + 1
        row = row + 1
    ENDWHILE
ENDPROC

PROC APPLY_RANDOM_PED()
    INT attempts = 0
    INT choice = 0
    WHILE attempts < 8
        choice = GET_RANDOM_INT_IN_RANGE(0, PED_CHOICE_COUNT())
        IF NOT g_ped_change_pending AND NOT IS_PED_IN_ANY_VEHICLE(PLAYER_PED_ID())
            IF IS_MODEL_IN_CDIMAGE(PED_MODEL_FOR_CHOICE(choice)) AND IS_MODEL_VALID(PED_MODEL_FOR_CHOICE(choice))
                SAVE_ACTIVE_CHARACTER_PED()
                g_ped_choice = choice
                g_ped_search_not_found = FALSE
                g_ped_search_has_value = TRUE
                g_ped_search_is_custom = FALSE
                g_ped_search_value = PED_NAME_FOR_CHOICE(choice)
                REQUEST_PED_CHANGE(PED_MODEL_FOR_CHOICE(choice))
                EXIT
            ENDIF
        ELSE
            EXIT
        ENDIF
        attempts = attempts + 1
    ENDWHILE
ENDPROC

PROC APPLY_RANDOM_GUARD_PED()
    INT attempts = 0
    INT choice = 0
    WHILE attempts < 8
        choice = GET_RANDOM_INT_IN_RANGE(0, PED_CHOICE_COUNT())
        IF IS_MODEL_IN_CDIMAGE(PED_MODEL_FOR_CHOICE(choice)) AND IS_MODEL_VALID(PED_MODEL_FOR_CHOICE(choice))
            g_guard_ped_choice = choice
            g_guard_ped_name = PED_NAME_FOR_CHOICE(choice)
            g_guard_ped_search_is_custom = FALSE
            g_guard_ped_search_not_found = FALSE
            EXIT
        ENDIF
        attempts = attempts + 1
    ENDWHILE
ENDPROC

PROC APPLY_RANDOM_ATTACKER_PED()
    INT attempts = 0
    INT choice = 0
    WHILE attempts < 8
        choice = GET_RANDOM_INT_IN_RANGE(0, PED_CHOICE_COUNT())
        IF IS_MODEL_IN_CDIMAGE(PED_MODEL_FOR_CHOICE(choice)) AND IS_MODEL_VALID(PED_MODEL_FOR_CHOICE(choice))
            g_attacker_ped_choice = choice
            g_attacker_ped_name = PED_NAME_FOR_CHOICE(choice)
            g_attacker_ped_search_is_custom = FALSE
            g_attacker_ped_search_not_found = FALSE
            EXIT
        ENDIF
        attempts = attempts + 1
    ENDWHILE
ENDPROC

PROC INIT_MENU_DEFAULTS()
    g_guard_ped_choice = PED_CHOICE_FOR_MODEL(PLAYER_ZERO)
    IF g_guard_ped_choice < 0 g_guard_ped_choice = 0 ENDIF
    g_guard_ped_name = PED_NAME_FOR_CHOICE(g_guard_ped_choice)
    g_attacker_ped_choice = g_guard_ped_choice
    g_attacker_ped_name = g_guard_ped_name
    g_guard_ped_search_is_custom = FALSE
    g_guard_ped_model = PLAYER_ZERO
    g_attacker_ped_search_is_custom = FALSE
    g_attacker_ped_model = PLAYER_ZERO
ENDPROC
